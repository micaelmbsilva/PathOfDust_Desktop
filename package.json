{
  "name": "lokati_overlay",
  "productName": "Path of Dust",
  "version": "29.0.0",
  "description": "Custom overlay + dashboard app for adventure.lokati.net",
  "main": "main.cjs",
  "author": "Kibukah",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.62.1"
  },
  "build": {
    "appId": "net.lokati.pathofdust",
    "productName": "Path of Dust",
    "asar": false,
    "files": [
      "**/*",
      "!server/**",
      "!dist/**",
      "!.github/**",
      "!.profile/**",
      "!.chrome/**",
      "!.appchrome/**",
      "!authed/**",
      "!auth.json",
      "!twitch.json",
      "!harvest.mjs",
      "!twitch-login.mjs",
      "!*.md"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "PathOfDust-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "micaelmbsilva",
      "repo": "PathOfDust_Desktop",
      "releaseType": "release"
    }
  }
}
