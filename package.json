{
  "name": "lokati_overlay",
  "productName": "Path of Dust",
  "version": "1.0.0",
  "description": "Custom overlay + dashboard app for adventure.lokati.net",
  "main": "main.cjs",
  "author": "Kibukah",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-packager . \"Path of Dust\" --platform=win32 --arch=x64 --out=dist --overwrite --prune=true --ignore=\"(\\.profile|\\.chrome|\\.appchrome|authed|dist|auth\\.json|twitch\\.json|node_modules/.cache)\""
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.62.1"
  },
  "build": {
    "appId": "net.lokati.overlay",
    "productName": "LokatiOverlay",
    "asar": false,
    "files": [
      "main.cjs",
      "server.mjs",
      "actions.mjs",
      "index.html",
      "bag.html",
      "passives.html",
      "auth.json",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "LokatiOverlay.exe"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
