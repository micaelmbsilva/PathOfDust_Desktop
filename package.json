{
  "name": "lokati_overlay",
  "productName": "Path of Dust",
  "version": "4.3.0",
  "description": "Custom overlay + dashboard app for adventure.lokati.net",
  "main": "main.cjs",
  "author": "Kibukah",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node advisor-core.test.mjs && node scrape.test.mjs && node codec.test.mjs",
    "bump": "node .githooks/bump.mjs",
    "release": "electron-builder --win --publish always",
    "release:mac": "electron-builder --mac --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "net.lokati.pathofdust",
    "afterPack": "./sign-mac.cjs",
    "productName": "Path of Dust",
    "asar": false,
    "files": [
      "**/*",
      "!server/**",
      "!dist/**",
      "!.github/**",
      "!.profile/**",
      "!.chrome/**",
      "!.appchrome/**",
      "!authed/**",
      "!auth.json",
      "!twitch.json",
      "!harvest.mjs",
      "!twitch-login.mjs",
      "!*.md",
      "!.claude/**",
      "!wiki/**",
      "!*.test.mjs",
      "!findings-*.json",
      "!intel-*.json",
      "!run.txt",
      "!sign-mac.cjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "PathOfDust-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "PathOfDust-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "micaelmbsilva",
      "repo": "PathOfDust_Desktop",
      "releaseType": "release"
    }
  }
}
